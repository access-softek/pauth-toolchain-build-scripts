# Configuration file to be sourced by the build scripts.

### LLVM and Musl versions to build ###

# Branches or tags being checked out by "docker.sh sources".
LLVM_BRANCH=llvmorg-21.1.6
MUSL_BRANCH=v1.2.5-pauth-rev2025-11-21

# Expected hashes at these branches.
LLVM_SHA=a832a5222e489298337fbb5876f8dcaf072c5cca
MUSL_SHA=b37ee52aff13880884a7afa8c5161a4f4f7e0236

TOOLCHAIN_TARGETS="aarch64-linux-musl aarch64-linux-pauthtest"

TARGET_COMMON_CFLAGS="-fdebug-default-version=4 -gdwarf-4 -march=armv8.3-a+pauth"

# Extra flags to write to Clang config files as the defaults.
TARGET_EXTRA_CFLAGS_aarch64_linux_pauthtest="-Xclang -fptrauth-elf-got"
TARGET_EXTRA_CFLAGS_aarch64_linux_musl=""

### Other variables ###

BUILD_OPTIMIZED_RUNTIMES=yes

# The target sysroot installation prefix.
# This path is used inside the container as a temporary location to install
# the toolchain before packing it into a SquashFS image.
#INSTALL_DIR=/opt/llvm-pauth

# Command to build and run containers on the host: docker, podman, etc.
DOCKER_CMD=docker

# Container image name.
DOCKER_IMAGE_NAME=pauth-toolchain-builder

DEFAULT_LLVM_REPO_URL=https://github.com/llvm/llvm-project
DEFAULT_MUSL_REPO_URL=https://github.com/access-softek/musl
