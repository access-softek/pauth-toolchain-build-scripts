# Build configuration (to be sourced by the build scripts).

# Temporary directory inside the container to install the toolchain into.
INSTALL_DIR=/opt/llvm-pauth

# Directories mounted from the host to the container.
OUTPUT_DIR=/scripts/output
CCACHE_DIR=/scripts/ccache
SRC_DIR=/src
LLVM_SOURCE_DIR="$SRC_DIR/llvm"
MUSL_SOURCE_DIR="$SRC_DIR/musl"

LINUX_KERNEL_VERSION=6.1.58

CPU_COUNT="$(nproc)"

# Command to build and run containers on host: docker, podman, etc.
DOCKER_CMD=docker
