# LLVM version configuration (to be sourced by the build scripts).
#
# This file is intended to contain the variables that have to be updated when
# switching to a different LLVM branch, not to scatter the changes across
# various scripts in the repository.

# Branches being checked out by "docker.sh sources".
LLVM_BRANCH=llvmorg-21.1.0-rc1
MUSL_BRANCH=atrosinenko/reloc-ids

# Expected hashes at these branches.
LLVM_SHA=cbcb48a88c3a6227cfc09f91880d5cb92a26f5f9
MUSL_SHA=adfc8bd122b0c918a324abf55881dbd9b7c879fd

# Extra flags to write to Clang config files as the defaults.
EXTRA_FLAGS_PAUTHTEST="-Xclang -fptrauth-elf-got"
EXTRA_FLAGS_MUSL=""
